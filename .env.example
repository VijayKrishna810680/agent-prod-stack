APP_ENVIRONMENT=development

APP_PRIMARY_MODEL=gpt-4o-mini
APP_FALLBACK_MODELS=["claude-3-5-haiku-20241022"]

APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_db
APP_REDIS_URL=redis://localhost:6379/0
APP_RATE_LIMIT_PER_MINUTE=60
APP_CACHE_TTL_SECONDS=300

APP_TRACING_ENABLED=false
APP_LANGFUSE_PUBLIC_KEY=
APP_LANGFUSE_SECRET_KEY=

# Provider keys read directly by LiteLLM, not by this app:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
